{
  "name": "clinica-ikigai",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema integrado de gestão da Clínica Ikigai",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "npm run build",
    "dev": "concurrently --kill-others --names API,SITE \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace frontend && npm run test --workspace backend",
    "test:whatsapp": "npm run test:whatsapp --workspace backend",
    "test:whatsapp:baileys": "npm run test:whatsapp:baileys --workspace backend",
    "test:whatsapp:etapa2": "npm run test:whatsapp:etapa2 --workspace backend",
    "whatsapp:baileys": "npm run whatsapp:baileys --workspace backend",
    "lint": "npm run lint --workspace frontend",
    "admin:provisionar": "npm run admin:provisionar --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:backup": "npm run db:backup --workspace backend",
    "db:seed:apresentacao": "npm run db:seed:apresentacao --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "minimatch": "11.0.1",
    "eslint": "^10.3.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.59.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0"
  },
  "overrides": {
    "minimatch": "$minimatch"
  }
}