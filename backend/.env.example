# Configuracao do Servidor Express
PORT=3000

# Configuracoes do Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=sua_senha_do_mysql
DB_NAME=clinica_ikigai_db

# Origens permitidas pelo CORS (separadas por virgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting (requisicoes por janela de tempo)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Acesso local por padrão. Configure explicitamente para publicar.
HOST=127.0.0.1
# Em produção use NODE_ENV=production e um segredo aleatório com ao menos 32 bytes.
SESSION_SECRET=
# Ative somente se o proxy HTTPS na mesma máquina sobrescreve X-Forwarded-Proto.
TRUST_PROXY_LOOPBACK=false
# Forneça ADMIN_INITIAL_EMAIL e ADMIN_INITIAL_PASSWORD somente ao comando admin:provisionar.
# Credenciais administrativas separadas, usadas somente por migrações, backup e testes.
# DB_ADMIN_USER=
# DB_ADMIN_PASS=
# Caminho do executável mysqldump, quando não estiver no PATH.
# MYSQLDUMP_PATH=

# Comunicação com pacientes. Habilite "simulado" somente para simulação local.
COMUNICACAO_PROVEDOR=
# Resultados de teste: submetida, entregue, rejeitada ou timeout.
COMUNICACAO_SIMULAR_RESULTADO=submetida
# O processamento de lembretes exige uma janela em minutos e um fuso IANA.
LEMBRETE_ANTECEDENCIA_MINUTOS=1440
LEMBRETE_FUSO=America/Sao_Paulo
