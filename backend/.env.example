# Configuracao do Servidor Express
PORT=3000

# Configuracoes do Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=sua_senha_do_mysql
DB_NAME=clinica_ikigai_db

# Origens permitidas pelo CORS (separadas por virgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting (requisicoes por janela de tempo)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Acesso local por padrão. Configure explicitamente para publicar.
HOST=127.0.0.1
# Em produção use NODE_ENV=production e um segredo aleatório com ao menos 32 bytes.
SESSION_SECRET=
# Ative somente se o proxy HTTPS na mesma máquina sobrescreve X-Forwarded-Proto.
TRUST_PROXY_LOOPBACK=false
# Forneça ADMIN_INITIAL_EMAIL e ADMIN_INITIAL_PASSWORD somente ao comando admin:provisionar.
# Credenciais administrativas separadas, usadas somente por migrações, backup e testes.
# DB_ADMIN_USER=
# DB_ADMIN_PASS=
# Caminho do executável mysqldump, quando não estiver no PATH.
# MYSQLDUMP_PATH=

# Comunicação com pacientes. Use "simulado" para testes locais ou "whatsapp" para disparar pelo conector WhatsApp ativo.
COMUNICACAO_PROVEDOR=
# Resultados de teste: submetida, entregue, rejeitada ou timeout.
COMUNICACAO_SIMULAR_RESULTADO=submetida
# O processamento de lembretes exige uma janela em minutos e um fuso IANA.
LEMBRETE_ANTECEDENCIA_MINUTOS=1440
LEMBRETE_FUSO=America/Sao_Paulo

# Integração WhatsApp (Etapa 1 / Etapa 1.1 - Baileys)
# Habilita apenas o webhook local de simulação por padrão; nunca envia mensagens reais sem habilitação explícita.
WHATSAPP_MODE=simulation
WHATSAPP_SIMULATION_KEY=DEFINA_UMA_CHAVE_ALEATORIA_LONGA_LOCALMENTE

# Configurações do conector não oficial Baileys (Etapa 1.1)
# Conexão e envio reais permanecem desabilitados por padrão por segurança.
WHATSAPP_BAILEYS_ENABLED=false
WHATSAPP_SEND_ENABLED=false
# Defina como true apenas quando quiser liberar o bot para responder qualquer número individual (fora da allowlist)
WHATSAPP_ALLOW_ANY_NUMBER=false
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_SESSION_DIR=.whatsapp-session
WHATSAPP_MAX_RECONNECT_ATTEMPTS=3
WHATSAPP_RECONNECT_INTERVAL_MS=5000
WHATSAPP_RATE_LIMIT_PER_MINUTE=10

# Persistência das regras conversacionais da Etapa 2 ('auto' usa MySQL se conectado e memória em contingência; 'mysql' ou 'memory')
WHATSAPP_DB_MODE=auto
