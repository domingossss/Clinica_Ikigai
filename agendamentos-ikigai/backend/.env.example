# Configuracao do Servidor Express
PORT=3000

# Configuracoes do Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=ALTERE_ESTA_SENHA
DB_NAME=ikigai_db

# Origens permitidas pelo CORS (separadas por virgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting (requisicoes por janela de tempo)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
